# Copy to .env for local development. Render/Cloudflare get these as real env vars.
# Never commit .env.

# Generate with: uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True

# Comma-separated. Only needed for a custom domain in production; Render's own hostname
# is picked up automatically.
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon Postgres in every deployed environment. Leave blank locally to use SQLite.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Exact frontend origins, comma-separated. Never '*'.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
